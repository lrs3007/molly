# Configure in .env.local (gitignored). Never prefix speech secrets with VITE_.
# New Volcengine Speech Console > API Key management:
DOUBAO_API_KEY=
# Legacy console can use this pair instead of API Key:
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
# xiaohe (default), storybook, or yunzhou. Candidates require account permission.
DOUBAO_VOICE=xiaohe
