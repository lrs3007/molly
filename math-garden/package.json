{
  "name": "math-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts && node scripts/check-render.mjs",
    "audio": "node --experimental-strip-types scripts/export-qwen-plan.ts && .venv-tts/bin/python scripts/generate-qwen-audio.py --all",
    "audio:sample": "node --experimental-strip-types scripts/export-qwen-plan.ts && .venv-tts/bin/python scripts/generate-qwen-audio.py --sample",
    "audio:install": "node --experimental-strip-types scripts/install-qwen-audio.ts",
    "audio:doubao": "node --experimental-strip-types scripts/generate-doubao-audio.ts",
    "audio:system": "node --experimental-strip-types scripts/generate-audio.ts",
    "audio:plan": "node --experimental-strip-types scripts/export-qwen-plan.ts"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": {
    "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0", "typescript": "^5.9.0", "vite": "^7.1.0"
  }
}
