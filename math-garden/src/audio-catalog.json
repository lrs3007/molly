      "sha256": "8ffed99ebbee78c206e772f53c1be988b1990b6877069253e055281b3fe2e86f",
      "sampleRate": 24000
    },
    "ratio-3-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-3-3.af85a23d8021.wav",
      "text": "三十二支，表示的是两个人合起来的数量。请看图想一想，这个数对应几份呢？分清是和还是差，再选择答案。",
      "duration": 12.32,
      "signature": "d1c66036209c2c0aeedb21bb19bd7ced682af4b2798a55cac6b63790d861bb83",
      "sha256": "af85a23d80212f0711403e507ec20eedfb20b690e9dac5c70c7806a8ff0c16e2",
      "sampleRate": 24000
    },
    "ratio-3-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-3-4.407b73f94ffd.wav",
      "text": "现在把份数和支数对上。四份一共三十二支，所以一份是三十二除以四，等于八支。弟弟就是这一份。别急，题目问的姐姐，还要再算一步。",
      "duration": 12.05,
      "signature": "1305ff4d73b57c09538e765422495d4b92e758ceb9ad9c0e8985d68a0e7b9927",
      "sha256": "407b73f94ffd2de4cc5a4b7751b23fefe79aa899b381b6e3053163e1a499c8eb",
      "sampleRate": 24000
    },
    "ratio-3-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-3-5.ed287e44d007.wav",
      "text": "姐姐有三份，用八乘三，得到二十四支。再检查，二十四加八，正好是三十二。她的数量也是弟弟的三倍，两个条件都对上啦。",
      "duration": 12.45,
      "signature": "d5604e6eebf01b91033b04cae9c9ad92fe446d28793e215a7cd5eb84394217e2",
      "sha256": "ed287e44d007a06f4aab0053b0cb22569e427d65fd2401d916dd95446f23cb7d",
      "sampleRate": 24000
    },
    "ratio-4-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-4-1.925f91342fe3.wav",
      "text": "姐姐的彩笔是弟弟的四倍。题目还告诉咱们，姐姐比弟弟多二十四支。咱们要找姐姐有多少支。把弟弟看成一份，会更容易想。",
      "duration": 11.49,
      "signature": "fa3bfa9f0a644ac7686f4664d9d19e747da50e13ac58038aad46217e6636b32a",
      "sha256": "925f91342fe34e09a89b060c5f060a090caedcbdb2699e1573daa44965082e6d",
      "sampleRate": 24000
    },
    "ratio-4-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-4-2.ce5bd48715d5.wav",
      "text": "看线段图，弟弟画一份，姐姐就画四个同样长的份。把一样长的这一份对齐，姐姐多出的部分有四减一，也就是三份。每一份都一样多哦。",
      "duration": 12.85,
      "signature": "92cd62e6c491e79ac1ae578b17205bfb1a14a7ad58ff9b0a941f8549be698e75",
      "sha256": "ce5bd48715d585feadb54ad75a1e340b5c0ecd4fc71f509dc5929b366600efae",
      "sampleRate": 24000
    },
    "ratio-4-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-4-3.92fc2ec84b04.wav",
      "text": "二十四支，表示的是姐姐比弟弟多出的数量。请看图想一想，这个数对应几份呢？分清是和还是差，再选择答案。",
      "duration": 14.32,
      "signature": "1cc18c2aa513cbeb38cddd80ce900484573cb54132e8cae292251cf51a19c356",
      "sha256": "92fc2ec84b04ce42e1fa02daabfd1680333b0f5ca1279f52f781afa4be99ee63",
      "sampleRate": 24000
    },
    "ratio-4-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-4-4.23bed007215e.wav",
      "text": "现在把份数和支数对上。三份一共二十四支，所以一份是二十四除以三，等于八支。弟弟就是这一份。别急，题目问的姐姐，还要再算一步。",
      "duration": 13.25,
      "signature": "a986c6bd93c5c9db1836e07b97cd8e5c4baf21bd0d061d406137bac16490cd6e",
      "sha256": "23bed007215e3b3f55f21f233f60c97bffa39685bc2f6663b4951fe507200780",
      "sampleRate": 24000
    },
    "ratio-4-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-4-5.5c832d0e91bb.wav",
      "text": "姐姐有四份，用八乘四，得到三十二支。再检查，三十二减八，正好是二十四。她的数量也是弟弟的四倍，两个条件都对上啦。",
      "duration": 12.05,
      "signature": "fbd5482164b07084346507fa348b98e1b5e48dd35a44dfcbc07a10ece1b68719",
      "sha256": "5c832d0e91bbacdb6ffb69b7b11eced3fdd43034b11c379a4eae2930130d6187",
      "sampleRate": 24000
    },
    "transfer-3-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-3-1.fd13491ed504.wav",
      "text": "小米有十四颗弹珠，小禾只有六颗。小米想分一些给小禾，让两人一样多。先别猜要送几颗，咱们一起看看，移动会怎样改变两盘的数量。",
      "duration": 13.49,
      "signature": "1e3d7a85e20dbe1f557b97bb1f0d79c693fd870312c383f907522c86641734b5",
      "sha256": "fd13491ed504ef006d5d34cb8c8b54adb5966cda2d173aa61ef2d920e3f4cb26",
      "sampleRate": 24000
    },
    "transfer-3-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-3-2.1afb82550d9d.wav",
      "text": "看，先移一颗。小米从十四变成十三，小禾从六变成七。小米少一颗，小禾多一颗，两边同时改变，所以数量差一下就缩小了两颗。",
      "duration": 16.21,
      "signature": "b88b2285e8d08b02543bf97f4552b3cf71d848ae09a9576fa30ca2e23b9fb578",
      "sha256": "1afb82550d9dca46b76f355f951f5d774680d2b566a82076bd74dd4accd88e0c",
      "sampleRate": 24000
    },
    "transfer-3-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-3-3.c28b6e84429c.wav",
      "text": "原来十四比六多八颗。每移一颗，差就缩小两颗。要让差变成零，应该移多少颗呢？想一想，可不能把多出来的八颗全部送过去哦。",
      "duration": 12.16,
      "signature": "969ba250c3d539dd3dc8ce2823f15c57c8ad473dc4fad927e1b5720b7b407f1f",
      "sha256": "c28b6e84429c4ba25c280434d966056ae23039a7a2720b53fa7cba5a889f00fd",
      "sampleRate": 24000
    },
    "transfer-3-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-3-4.44b1ebc54e40.wav",
      "text": "看，把差八颗分成两半，八除以二，等于四。从小米这里移四颗给小禾。十四减四是十，六加四也是十，现在两盘一样多啦。",
      "duration": 18.29,
      "signature": "f43ccad92c47b56f2639d310cafabdf1c7d4c05a6734e94105812b459682af6d",
      "sha256": "44b1ebc54e40794dc74d16b208ac8048787285100679ee3b79a340863823731b",
      "sampleRate": 24000
    },
    "transfer-3-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-3-5.b89efdb5015b.wav",
      "text": "为什么要除以二？因为每移一颗，给的一方少一，收的一方多一，差会缩小二。总数还是二十颗，平均每人十颗。记住，求移动多少，要用数量差的一半。",
      "duration": 14.13,
      "signature": "2d029e31dd8818c450bfa6eb954f00db5af7571148a82a1486369a3c854fdaaf",
      "sha256": "b89efdb5015b19940a215021b22aac6b1ac956acd37315342e003b1e32b0a8c7",
      "sampleRate": 24000
    },
    "transfer-4-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-4-1.456cd0bbf535.wav",
      "text": "小米给了小禾五颗弹珠以后，两人都是十八颗。咱们要找小米原来有多少颗。注意，十八颗是给过以后的数量，不是小米原来的数量哦。",
      "duration": 12.45,
      "signature": "53450e6b22fb62f9415eca5efa772efd097545c1d597b137a90bdf7814b3a792",
      "sha256": "456cd0bbf535fc0d155e61eb10293e8ca5b49537f0c8189d46c7ef109e39720e",
      "sampleRate": 24000
    },
    "transfer-4-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-4-2.b3eb75f220c9.wav",
      "text": "看，画面先摆出移动后的结果，两盘都是十八颗。要回到原来，就把这五颗从小禾那边还给小米。像倒着放一段小动画，原来的数量就会出现。",
      "duration": 14.29,
      "signature": "194c2df402785ecf098217a400cfe5b089e8176b4e063700b37e6265812b49e5",
      "sha256": "b3eb75f220c938a78f677b386874845bca3ff9fab5136049aa498ba197c6e922",
      "sampleRate": 24000
    },
    "transfer-4-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-4-3.54bb40ae1f98.wav",
      "text": "小米原来比小禾多。送出五颗时，小米少五颗，小禾多五颗。请想一想，这样一来，两人的数量差一共缩小了多少颗？选好再看还原动画。",
      "duration": 15.12,
      "signature": "db9568d324112e6e718e5f58b733e42640f358004b33f24a0a9549573d29cc0d",
      "sha256": "54bb40ae1f981a612ece8bcad877344193613688efa7f53d5ab7dfa97dc75626",
      "sampleRate": 24000
    },
    "transfer-4-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-4-4.36db8ce8181d.wav",
      "text": "把五颗还给小米。小米是十八加五，原来二十三颗。小禾把刚才收到的五颗还出去，十八减五，原来十三颗。两人的总数，一直没有改变。",
      "duration": 16.77,
      "signature": "e9ef7bf05f0fd8fda0385fb2c136ccc0a0db2699d8d46c436501067711f8ab1a",
      "sha256": "36db8ce8181da3c9323ff50d6f1cc8b0f4bf7d716db8c35150ab901cf6dd7f6e",
      "sampleRate": 24000
    },
    "transfer-4-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/transfer-4-5.efbdc28cffa9.wav",
      "text": "咱们再顺着题目检查。小米二十三颗，送出五颗，还剩十八颗；小禾十三颗，收到五颗，也变成十八颗。记住，倒着求原来，给出的要加回，收到的要减去。",
      "duration": 15.09,
      "signature": "81659c5df29a558ac86a2599ccf94488716fd9d0373ac2172d3701f5db783256",
      "sha256": "efbdc28cffa9868ca3892332840ce4cc8fff95593afa390a466456e9c8a59272",
      "sampleRate": 24000
    },
    "geometry-3-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-3-1.d16904219055.wav",
      "text": "三个小正方形排成一行。题目问一共有几个长方形，特别说了，正方形也算。除了单独的小格子，两格、三格拼起来，也能组成新的长方形哦。",
      "duration": 13.57,
      "signature": "d9ace78b6f6ee81c79e4a5e4b72ff56959099027d808323b9def02b6b9e0f914",
      "sha256": "d169042190558889b8e76385aecc09818080c8ef7ef0b389c565ef289bd50e1d",
      "sampleRate": 24000
    },
    "geometry-3-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-3-2.b816fa0d5e3c.wav",
      "text": "先数宽一格的。最左边一个，中间一个，最右边一个，一共有三个。咱们给它们按位置排好队，这样每个只数一次，就不会重复。",
      "duration": 15.49,
      "signature": "1bd0c2f32e810201341258c549f9989f5e36f37d9b83ecb93d15d2ab8419d78f",
      "sha256": "b816fa0d5e3cc9770f8c23e993a1733af9a8a2920ce4ab34ce543cb8993a054e",
      "sampleRate": 24000
    },
    "geometry-3-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-3-3.7ab567823acf.wav",
      "text": "现在把框变宽，盖住连续的两格。它可以盖住左边两格，还能盖住哪两格呢？请看清位置，宽两格的框并不是只有一个，选一选吧。",
      "duration": 12.48,
      "signature": "2075674e3f6c568a53ebfadf6e1cc714c7f8f35c276fa3824331bb91a36247d9",
      "sha256": "7ab567823acfa44328eeb59f42476ada5af8a7bf22ded8b79015cbeaff7b1457",
      "sampleRate": 24000
    },
    "geometry-3-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-3-4.080dafd8db81.wav",
      "text": "看框从左边两格，移动到右边两格。宽两格的，一共有两个。再把框放大到宽三格，只能盖住整排，一共一个。虽然框会重叠，它们的位置却不同。",
      "duration": 15.25,
      "signature": "f400860b8880c2d8797b7aba2b2aaaa4b8f8a72c16e591398a20a36be180d9ad",
      "sha256": "080dafd8db81ea9db8851efaa11f97e03a235eef4658a91d7a619f373302132c",
      "sampleRate": 24000
    },
    "geometry-3-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-3-5.1ec9eb004ee1.wav",
      "text": "咱们把三类放在一起，宽一格三个，宽两格两个，宽三格一个。三加二加一，总共六个。数图形时，先分类，再按位置数，小图形和组合图形都要算。",
      "duration": 19.49,
      "signature": "720a9f48e1df9e9365d22394059d71124f1543487135efedb67f47258e5bcf99",
      "sha256": "1ec9eb004ee1eb6b3430832a2971d70e7f5f2bca6637a9b92fbcf1572e0c0910",
      "sampleRate": 24000
    },
    "geometry-4-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-4-1.d8001e6dd094.wav",
      "text": "看这个三行三列的方格图。题目要数的是正方形，而且每条边都要沿着格线。除了眼前的小格子，还有藏在里面的大正方形哦。咱们按边长分类找。",
      "duration": 13.57,
      "signature": "6599821fbdaf369aa4a936b85ea960eb3674a431b70278a912d45dd1737c295a",
      "sha256": "d8001e6dd09482ea69bd57184f9e19c14ef20f81be6b49ad6d9ec372469e640b",
      "sampleRate": 24000
    },
    "geometry-4-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-4-2.262a0eb23da5.wav",
      "text": "先看边长一格的小正方形。一行有三个，一共有三行，所以是九个。看，高亮框按顺序一个一个走，咱们从左到右，再从上到下，就不容易漏掉。",
      "duration": 12.93,
      "signature": "38c256ab4033815287534853dc16b4669acf326aa8c671ad3515d1dacbe751a8",
      "sha256": "262a0eb23da56b18afca5d8ca42fb017b8452220073e72757caf846f67b31854",
      "sampleRate": 24000
    },
    "geometry-4-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-4-3.74b8dfed87d0.wav",
      "text": "再想一想，边长两格的正方形有几个？试着让框从左上角开始，向右移，再向下移。它们可以重叠，但左上角的位置不同，就算不同的正方形。",
      "duration": 14.96,
      "signature": "c6c157c7b53afd4d391f5642595fd7f5b095b016534af66d68078bce3e73e211",
      "sha256": "74b8dfed87d08a9e902a6b27690817cd8118555d5cdc4fc76b3887152b61876c",
      "sampleRate": 24000
    },
    "geometry-4-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-4-4.49dd3d17b2b3.wav",
      "text": "看边长两格的框，左上角能放在四个位置，所以有四个。再放大成边长三格，就只能盖住整个图，一共一个。大图形要单独数，不能只数小格子。",
      "duration": 12.69,
      "signature": "7352c46bbfd361dfc8c1e13767221eb19b3a54c26380a849472e0328cff6a1b1",
      "sha256": "49dd3d17b2b321b7a8e78e67bfbeb82570f3db461dc66b697a966842acdd2256",
      "sampleRate": 24000
    },
    "geometry-4-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/geometry-4-5.e3528b6b298a.wav",
      "text": "现在把三类合起来。边长一格有九个，边长两格有四个，边长三格有一个。九加四加一，一共十四个。按大小分类，每类按位置数，最后再相加。",
      "duration": 16.53,
      "signature": "059b9c03631132221e5dc350f11664d426b7f458c07ea0b47b06621af15bf115",
      "sha256": "e3528b6b298a67f5c77076d0c935c511698d2b5ebaec00cad8f436f22caa42b2",
      "sampleRate": 24000
    },
    "age-3-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-3-1.043f63c20588.wav",
      "text": "爸爸今年三十二岁，小明今年八岁。题目问，几年后，爸爸的年龄会是小明的三倍。两个人的年龄都在变，咱们先找一个不变的关系。",
      "duration": 17.25,
      "signature": "a268acd23f30f815731d13ec7929e27cf914a1cd4e68cac8b32ccc825354443d",
      "sha256": "043f63c205882fe72cdbb40fd6388473bc45f1e75d550499c5e32649684ee38c",
      "sampleRate": 24000
    },
    "age-3-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-3-2.497be2084964.wav",
      "text": "过一年，两个人都增加一岁。爸爸和小明的年龄差，还是二十四岁。往前倒一年，两个人都减一岁，差也一样。看时间轴，两条线一起走，距离始终不变。",
      "duration": 14.45,
      "signature": "9974e3b3061ecc5c81599992c1737ea3c6afb574150ec3d5874a7f0a5dec0933",
      "sha256": "497be20849643272275739dc93636c5eb37d02235f4102c676a9dc1cb5322327",
      "sampleRate": 24000
    },
    "age-3-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-3-3.071dff04c02f.wav",
      "text": "到了三倍的那个时刻，把孩子的年龄看成一份，大人就是三份。请看线段想一想，年龄差对应的是三份，还是三减一得到的两份呢？选好再继续。",
      "duration": 15.68,
      "signature": "e9e735d7e63280d71ee48be68784470b8f6636bb0ec3632e0a26588cdbfa8e68",
      "sha256": "071dff04c02f0606a16ad8b8e4a9f44abf42c62b54d7c8edb39d80e48a0e23e1",
      "sampleRate": 24000
    },
    "age-3-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-3-4.ee682a4f3fcd.wav",
      "text": "年龄差一直是二十四岁，对应两份。所以孩子那时是二十四除以二，等于十二岁。大人三份，就是三十六岁。先求那个时刻的年龄，还不是最后的年数哦。",
      "duration": 16.37,
      "signature": "84ce430d838e9b1f2630d76edd9eb2e1dd44323e3a8bc30969275084c084bb2f",
      "sha256": "ee682a4f3fcd5fef74f35c379d77c7583efabf92e958cd21234c0b551be0001f",
      "sampleRate": 24000
    },
    "age-3-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-3-5.c87f69e23b47.wav",
      "text": "小明今年八岁，要长到十二岁，相差四年。所以是四年后。检查一下，那时大人三十六岁，孩子十二岁，正好是三倍。每个人都要一起加上这四岁。",
      "duration": 13.89,
      "signature": "b5d039c84542c5a4da3bfb02948466e8d37dfcf54f8c9d044fb5064b0fcbbec4",
      "sha256": "c87f69e23b477ba2ecb9fa4626f22d80e75b67d26e501ceaf599f255939b3e5e",
      "sampleRate": 24000
    },
    "age-4-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-4-1.7c7c615139db.wav",
      "text": "妈妈今年三十五岁，小禾今年十五岁。题目问，几年前，妈妈的年龄会是小禾的三倍。两个人的年龄都在变，咱们先找一个不变的关系。",
      "duration": 15.57,
      "signature": "da38df1fbac595bcd8ef081b0e8d16843bcd05c3d47a644c0162f9e2a4b1ad82",
      "sha256": "7c7c615139db854f5d8161844b66d083ac9cc4e3bbae0cccb65e07716a27889e",
      "sampleRate": 24000
    },
    "age-4-2": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-4-2.4fe7fe9c8bea.wav",
      "text": "过一年，两个人都增加一岁。妈妈和小禾的年龄差，还是二十岁。往前倒一年，两个人都减一岁，差也一样。看时间轴，两条线一起走，距离始终不变。",
      "duration": 16.85,
      "signature": "eb1c67675757274eb3f8ba85cdb29011e9c5ec6e417b5a126aca2ce13eafd2f8",
      "sha256": "4fe7fe9c8beac16ff1c7215339eeb43bc3ebc634b38d1239c203eb444b23d2fc",
      "sampleRate": 24000
    },
    "age-4-3": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-4-3.a79bf2336509.wav",
      "text": "到了三倍的那个时刻，把孩子的年龄看成一份，大人就是三份。请看线段想一想，年龄差对应的是三份，还是三减一得到的两份呢？选好再继续。",
      "duration": 16.32,
      "signature": "4eb435d33c055ca7c561944f10eb1123641858dbd1773a3fb3290d183a585ea5",
      "sha256": "a79bf23365091bae1242cc432c70d76e3d943817c209350dd1f34bd18fcee4c6",
      "sampleRate": 24000
    },
    "age-4-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-4-4.5d5a75e38b68.wav",
      "text": "年龄差一直是二十岁，对应两份。所以孩子那时是二十除以二，等于十岁。大人三份，就是三十岁。先求那个时刻的年龄，还不是最后的年数哦。",
      "duration": 13.97,
      "signature": "9d25ae143f2d8e4d4b61e901d31267854eb542c5d3e1a0186e72e27989a07c55",
      "sha256": "5d5a75e38b68815fec39f27d25592e9935b8a475696772b207e32a638d3485a3",
      "sampleRate": 24000
    },
    "age-4-5": {
      "src": "/audio/qwen3/4d43ab7a32c7/age-4-5.dc7d444dd206.wav",
      "text": "小禾今年十五岁，要倒回十岁，相差五年。所以是五年前。检查一下，那时大人三十岁，孩子十岁，正好是三倍。每个人都要一起减去这五岁。",
      "duration": 15.09,
      "signature": "067c37722a34645fdf058eb2663fb903dc2f7ac378c2328e1c7b2c59b6caaed6",
      "sha256": "dc7d444dd20674eaef3c56d2a1f6bb9baca135785e2f05ddb90c913ec71c143b",
      "sampleRate": 24000
    }
  }
}
