      "signature": "2a8ae798e6377a1a0ca694db453995b4e46264815826bf9dce56219a6c51280e",
      "sha256": "14e4d3de239ea827da4abfbec38a1b1f69dcc68def34fa8aac7a307c8d2363fe",
      "sampleRate": 24000
    },
    "average-4-4": {
      "src": "/audio/qwen3/4d43ab7a32c7/average-4-4.6d3d0ee53636.wav",
      "text": "把前三盒加起来，六加八加十，等于二十四。再从三十六里面减去二十四，得到十二。看，被遮住的最后一盒，原来有十二块积木。",
