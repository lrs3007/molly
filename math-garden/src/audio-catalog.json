      "signature": "2b0fd4af9170347b9ab4e28e5d2a3f3527c8a8775f18502963717a42d0441f4a",
      "sha256": "10facf98a7bbdb1b201dd8c948c75a646ae372d278d9d65666642d3270d2db2b",
      "sampleRate": 24000
    },
    "ratio-3-1": {
      "src": "/audio/qwen3/4d43ab7a32c7/ratio-3-1.879eb1ca88ec.wav",
      "text": "姐姐的彩笔是弟弟的三倍。题目还告诉咱们，两人一共有三十二支。咱们要找姐姐有多少支。把弟弟看成一份，会更容易想。",
